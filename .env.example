# Supabase Database & Auth Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# JWT & Application Server
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars
PORT=5050
NODE_ENV=development

# Security & CORS
CORS_ORIGIN=*

# Demo Presentation Mode (true enables 1-click demo logins and demo toolbar)
DEMO_MODE=false

# AI Matching Cosine Similarity Threshold for text-to-photo matching (default: 22)
TEXT_IMAGE_MATCH_THRESHOLD=22

# SMTP Configuration (Optional in development; if empty, OTP codes print to server console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@campus.edu
SMTP_PASS=your-app-password
SMTP_FROM="Campus Lost & Found" <your-email@campus.edu>
