# Application Server & Environment
PORT=5050
NODE_ENV=development

# AI Microservice URL (Local: http://127.0.0.1:8000 | Deployed HF Space: https://<username>-<space-name>.hf.space)
AI_SERVICE_URL=http://127.0.0.1:8000

# Security & CORS (Use comma-separated origins for production, e.g. https://campus-lostfound.onrender.com)
CORS_ORIGIN=*

# Supabase Database & Cloud Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# JWT Secret (generate a strong 64+ char random string)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars

# AI Matching Cosine Similarity Threshold for text-to-photo matching (default: 22)
TEXT_IMAGE_MATCH_THRESHOLD=22

# Demo Presentation Mode (true enables 1-click demo logins and floating presentation toolbar)
DEMO_MODE=false

# Production SMTP Email Delivery (Gmail App Password)
# Required in production for student verification OTP emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@campus.edu
SMTP_PASS=your-16-char-gmail-app-password
SMTP_FROM="Campus Lost & Found" <your-email@campus.edu>
